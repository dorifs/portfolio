---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Projects from "../../components/Projects.astro";
import Imagen from "../../components/Imagen.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import Contact from "../../components/Contact.astro";
import Footer from "../../components/Footer.astro";

import { useTranslations } from "../../utils/useTranslation";
import About from "../../components/About.astro";
const t = useTranslations('de');
---

<Layout title="Portfolio | Dori Fernández">
  <section 
    id="home"
    class="min-h-screen flex items-center justify-center px-6 py-32">
    <Header nav={t.nav} />
    <div class="max-w-7xl w-full flex flex-col md:flex-row items-center md:items-start justify-between gap-12">
      <div class="text-center md:text-left flex-1">
        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold bg-gradient-to-r from-sky-300 to-blue-200 bg-clip-text text-transparent mb-4">
          Dori Fernández
        </h1>
        <p class="text-gray-300 text-base sm:text-lg">
          <span class="font-semibold text-white">Junior Webentwicklerin</span> mit Leidenschaft für die Erstellung digitaler Erlebnisse, die 
          <span class="text-blue-300 font-medium">nachhaltig</span>, 
          <span class="text-blue-300 font-medium">zugänglich</span> und 
          <span class="text-blue-300 font-medium">effizient</span> sind.
        </p>

        <p class="text-gray-400 text-base sm:text-lg mt-4">
          Dieses Portfolio wurde mit 
          <span class="text-white font-medium">Astro</span>, 
          <span class="text-white font-medium">TypeScript</span> und 
          <span class="text-white font-medium">Tailwind CSS</span> erstellt.
        </p>

        <p class="text-gray-400 text-base sm:text-lg mt-4">
          Im Abschnitt <a href="#projects" class="text-blue-300 font-medium">Projekte</a> kannst du Arbeiten entdecken, die mit weiteren Technologien wie 
          <span class="text-white font-semibold">Vue</span>, 
          <span class="text-white font-semibold">Nuxt</span>, 
          <span class="text-white font-semibold">PHP</span> und mehr umgesetzt wurden.
        </p>

        <div class="pt-2 flex justify-center md:justify-start">
          <SocialLinks />
        </div>
      </div>
      <div class="flex-1 flex justify-center">
        <Imagen />
      </div>
    </div>
  </section>

  <section
    id="projects"
    class="min-h-screen flex flex-col items-center justify-center py-24 px-6 fade-in-up">
    <h2 class="text-4xl font-bold text-blue-200 mb-6">{t.projects.title}</h2>
      <Projects translations={t.projects} />
  </section>

  <section
    id="experience"
    class="min-h-screen flex flex-col items-center justify-center py-24 px-6 fade-in-up">
    <h2 class="text-4xl font-bold text-blue-200 mb-6">Experiencia</h2>
       <About experiences={t.about.experiences} />
  </section>


  <section
    id="contact"
    class="min-h-screen flex flex-col items-center justify-center py-24 px-6 fade-in-up">
    <h2 class="text-4xl font-bold text-blue-200 mb-6">{t.nav.contact}</h2>
    <Contact
      message={t.contact.message}
      email={t.contact.email}
      phone={t.contact.phone}
    />
  </section>
  <Footer />
</Layout>
