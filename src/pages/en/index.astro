---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Projects from "../../components/Projects.astro";
import Imagen from "../../components/Imagen.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import Contact from "../../components/Contact.astro";
import About from "../../components/About.astro";
import Footer from "../../components/Footer.astro";

import { useTranslations } from "../../utils/useTranslation";
const t = useTranslations('en');
---

<Layout title="Portfolio | Dori Fernández">
  <section 
    id="home"
    class="min-h-screen flex items-center justify-center px-6 py-32">
    <Header nav={t.nav} />
    <div class="max-w-7xl w-full flex flex-col md:flex-row items-center md:items-start justify-between gap-12">
      <div class="text-center md:text-left flex-1">
        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold bg-gradient-to-r from-sky-300 to-blue-200 bg-clip-text text-transparent mb-4">
          Dori Fernández
        </h1>
        <p class="text-xl text-slate-300 max-w-xl mb-6">
        <p class="text-gray-200 text-base sm:text-lg">
            <span class="font-semibold text-white">Junior web developer</span> passionate about building digital experiences that are 
            <span class="text-blue-300 font-medium">sustainable</span>, 
            <span class="text-blue-300 font-medium">accessible</span>, and 
            <span class="text-blue-300 font-medium">efficient</span>.
          </p>

          <p class="text-gray-400 text-base sm:text-lg mt-4">
            This portfolio is built with 
            <span class="text-white font-medium">Astro</span>, 
            <span class="text-white font-medium">TypeScript</span>, and 
            <span class="text-white font-medium">Tailwind CSS</span>.
          </p>

          <p class="text-gray-400 text-base sm:text-lg mt-4">
            In the <a href="#projects" class="text-blue-300 font-medium">Projects</a> section, you can explore work created with other technologies such as 
            <span class="text-white font-semibold">Vue</span>, 
            <span class="text-white font-semibold">Nuxt</span>, 
            <span class="text-white font-semibold">PHP</span>, and more.
          </p>
        </p>
        <div class="pt-2 flex justify-center md:justify-start">
          <SocialLinks />
        </div>
      </div>
      <div class="flex-1 flex justify-center">
        <Imagen />
      </div>
    </div>
  </section>

  <section
    id="projects"
    class="min-h-screen flex flex-col items-center justify-center py-24 px-6 fade-in-up">
    <h2 class="text-4xl font-bold text-blue-200 mb-6">{t.projects.title}</h2>
      <Projects translations={t.projects} />
  </section>

    <section
      id="experience"
      class="min-h-screen flex flex-col items-center justify-center py-24 px-6 fade-in-up">
      <h2 class="text-4xl font-bold text-blue-200 mb-6">Experiencia</h2>
        <About experiences={t.about.experiences} />
    </section>


  <section
    id="contact"
    class="min-h-screen flex flex-col items-center justify-center py-24 px-6 fade-in-up">
    <h2 class="text-4xl font-bold text-blue-200 mb-6">{t.nav.contact}</h2>
    <Contact
      message={t.contact.message}
      email={t.contact.email}
      phone={t.contact.phone}
    />
  </section>
  <Footer />
</Layout>
