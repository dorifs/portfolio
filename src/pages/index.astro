---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
---

<Layout title="Portfolio | Dori Fernández">
  <!-- Hero Section -->
  <section
    id="home"
    class="min-h-screen bg-[#1e293b] text-white flex flex-col items-center justify-center py-32 px-6 text-center fade-in-up"
  >
    <p class="text-lg text-slate-300 mb-2">Hola, soy</p>
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold bg-gradient-to-r from-sky-400 to-blue-500 bg-clip-text text-transparent mb-4">
      Dori Fernández
    </h1>
    <p class="text-xl text-slate-400 max-w-2xl mb-8">
      Frontend Developer apasionada por crear experiencias digitales elegantes, accesibles y eficientes.
    </p>

    <!-- Avatar -->
    <div class="relative mb-8">
      <div class="absolute inset-0 w-64 h-64 rounded-full bg-blue-800 opacity-30 blur-2xl mx-auto"></div>
      <img
        src="public/retrato.png"
        alt="Ilustración de Dori"
        class="relative w-64 h-64 object-contain z-10"
      />
    </div>

    <!-- Social Icons (si tienes) -->
    <div class="flex gap-4">
      <a href="https://linkedin.com" target="_blank" class="hover:scale-110 transition-transform">
        <img src="/icons/linkedin.svg" alt="LinkedIn" class="w-6 h-6" />
      </a>
      <a href="https://github.com" target="_blank" class="hover:scale-110 transition-transform">
        <img src="/icons/github.svg" alt="GitHub" class="w-6 h-6" />
      </a>
      <a href="mailto:tucorreo@email.com" class="hover:scale-110 transition-transform">
        <img src="/icons/mail.svg" alt="Email" class="w-6 h-6" />
      </a>
    </div>
  </section>

  <!-- About Section -->
  <section
    id="experience"
    class="min-h-screen bg-slate-800 text-white flex flex-col items-center justify-center py-24 px-6 fade-in-up"
  >
    <h2 class="text-4xl font-bold text-blue-200 mb-6">Sobre mí</h2>
    <About />
  </section>

  <!-- Projects Section -->
  <section
    id="projects"
    class="min-h-screen bg-slate-700 text-white flex flex-col items-center justify-center py-24 px-6 fade-in-up"
  >
    <h2 class="text-4xl font-bold text-blue-200 mb-6">Proyectos</h2>
    <Projects />
  </section>
</Layout>

<style>
  .fade-in-up {
    opacity: 0;
    transform: translateY(40px);
    animation: fadeUp 1s ease-out forwards;
    animation-delay: 0.3s;
  }

  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  html {
    scroll-behavior: smooth;
  }
</style>
