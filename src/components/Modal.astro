---
import Carrusel from './Carrusel.vue';

export interface Props {
  id: string;
  title: string;
  content: string;
  link?: string;
  buttonLabel?: string;
  images: string[];
}

const {
  id,
  title,
  content,
  link,
  buttonLabel = "Leer más",
  images = []
} = Astro.props;
---

<div id={id} class="fixed inset-0 z-50 bg-black/70 flex items-center justify-center hidden">
  <div class="bg-white dark:bg-slate-800 p-6 rounded-xl max-w-3xl w-full relative shadow-2xl overflow-hidden">
    
    <button
      onclick={`document.getElementById('${id}').classList.add('hidden')`}
      class="absolute top-3 right-3 text-gray-500 hover:text-gray-900 dark:hover:text-white text-xl"
      aria-label="Cerrar"
    >
      &times;
    </button>

    <h2 class="text-2xl font-semibold mb-4 text-gray-800 dark:text-white">{title}</h2>

    <p class="mb-6 text-gray-700 dark:text-gray-300">{content}</p>

    <Carrusel images={images} client:load />

    {link && (
      <div class="mt-6 text-right">
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sky-600 dark:text-sky-400 hover:underline font-medium"
        >
          {buttonLabel}
        </a>
      </div>
    )}
  </div>
</div>
