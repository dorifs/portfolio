---
import Layout from '../layouts/Layout.astro';
import CardProject from '../components/CardProject.astro';

export interface Props {
  translations: {
    gameverse: {
      title: string;
      description: string;
      buttonLabel: string;
    };
    impulso: {
      title: string;
      description: string;
      buttonLabel: string;
    };
  };
}


const { translations } = Astro.props;
---

<Layout title="projects">
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 px-4 py-8">

<CardProject
  title={translations.gameverse.title}
  description={translations.gameverse.description}
  imgSrc="/GAMEverse.png"
  alt="GAMEverse"
  buttonLabel={translations.gameverse.buttonLabel}
  link="https://github.com/dorifs/ecommerce.git"
  images={[
    "https://player.vimeo.com/video/1106111889?autoplay=1&muted=1&title=0&byline=0&portrait=0",
    '/GAMEverse2.png',
    '/GAMEverse3.png',
    '/GAMEverse4.png',
    '/GAMEverse5.png',
    '/GAMEverse6.png',
  ]}
/>

    <CardProject
      title={translations.impulso.title}
      description={translations.impulso.description}
      imgSrc="/ImpulsoFamiliar.png"
      alt="Impulso familiar"
      buttonLabel={translations.impulso.buttonLabel}
      link="https://github.com/dorifs/impulsoFamiliar"
	   images={[
    '/Impulso1.png',
    '/Impulso2.png',
    '/Impulso3.png',
    '/Impulso5.png',
    '/Impulso6.png',
    '/Impulso7.png',
    '/Impulso8.png',
  ]}
    />

  </section>
</Layout>
