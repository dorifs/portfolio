---
import SocialLinks from "./SocialLinks.astro";
---

<section
  id="home"
  class="min-h-screen flex flex-col lg:flex-row items-center justify-center gap-12 px-6 py-24 bg-[#0f172a] text-white"
>
  <!-- Columna izquierda: texto -->
  <div class="flex-1 max-w-2xl text-left space-y-6">
    <p class="text-base text-slate-400">Hola, soy</p>
    <h1 class="text-5xl font-extrabold text-blue-400 leading-tight">Dori Fernández</h1>
    <h2 class="text-xl font-light text-slate-300">
      Frontend Developer apasionada por crear experiencias digitales elegantes y eficientes.
    </h2>

    <p class="text-sm md:text-base text-slate-300 leading-relaxed">
      <span class="text-white font-semibold">Desarrolladora Frontend Junior</span> en Sevilla, con experiencia en
      <span class="text-teal-400 font-medium"> Vue 3, Nuxt.js y Tailwind CSS</span>. Gran
      <span class="font-medium text-white"> adaptación intercultural</span> tras vivir en el extranjero. Apasionada por el
      <span class="underline underline-offset-4">aprendizaje constante</span> y el desarrollo de habilidades tecnológicas.
      <span title="España" aria-label="Bandera de España">🇪🇸</span>
      <span title="Alemania" aria-label="Bandera de Alemania">🇩🇪</span>
    </p>

    <div class="pt-2">
      <SocialLinks />
    </div>
  </div>

  <!-- Columna derecha: avatar -->
  <div class="flex-1 flex justify-center items-center relative">
    <!-- Círculo azul detrás del avatar -->
    <div class="absolute w-[380px] h-[380px] bg-blue-800 opacity-30 rounded-full blur-3xl"></div>

    <!-- Avatar -->
    <img
      src="public/retrato.png"
      alt="Ilustración de Dori"
      class="relative z-10 w-[320px] h-[320px] object-contain"
    />
  </div>
</section>
