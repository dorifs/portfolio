---
import NavLinks from "./NavLinks.astro";

export interface Props {
  nav: {
    home: string;
    projects: string;
    experience: string;
    contact: string;
  };
}

const { nav } = Astro.props;
---

<header class="fixed top-0 left-0 w-full z-50 bg-transparent transition justify-between items-center py-3 px-4 flex">
  <NavLinks nav={nav} />

  <div class="flex items-center gap-3 ml-auto">
    <a href="/es" title="Español">
      <span class="fi fi-es w-6 h-6 hover:scale-110 transition-transform cursor-pointer"></span>
    </a>
    <a href="/en" title="English">
      <span class="fi fi-gb w-6 h-6 hover:scale-110 transition-transform cursor-pointer"></span>
    </a>
    <a href="/de" title="Deutsch">
      <span class="fi fi-de w-6 h-6 hover:scale-110 transition-transform cursor-pointer"></span>
    </a>
  </div>
</header>
