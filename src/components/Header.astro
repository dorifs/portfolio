---
import NavLinks from "./NavLinks.astro";

export interface Props {
  nav: {
    home: string;
    projects: string;
    experience: string;
    contact: string;
  };
}

const { nav } = Astro.props;
---

<header class="fixed top-0 left-0 w-full z-50 bg-transparent transition justify-between items-center py-3 px-4 flex">
  <NavLinks nav={nav} />
</header>