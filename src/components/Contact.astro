---
import Footer from './Footer.astro';

  export interface Props {
  message: string;
  phone: string;
  email: string;
}

const { message, phone, email } = Astro.props;
---
<section id="contacto" class="px-4 py-16 bg-gray-900 text-gray-300">
  <div class="max-w-xl mx-auto bg-white dark:bg-slate-800 text-slate-900 dark:text-gray-100 rounded-xl shadow-lg p-8 space-y-8">
    <p class="text-center text-lg font-semibold">
        {message}
    </p>

    <div class="space-y-4 text-md text-center">
      <p class="text-gray-600 text-xm dark:text-sky-400">
          {email}       
      </p>

      <p class="text-gray-600 text-xm dark:text-sky-400">
          {phone}
      </p>
      </div>
  </div>
</section>


