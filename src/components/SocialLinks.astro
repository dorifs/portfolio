---
import LnkedIn from "./icons/LnkedIn.astro";
import Github from "./icons/Github.astro";
import EmailIcon from "./icons/EmailIcon.astro";
---
<ul class="flex gap-4">
    <li>
    <a href="https://github.com/dorifs"
      class="bg-gray-100 text-gray-800 text-xs 
        font-medium me-2 px-2.5 py-0.5 rounded-full 
        dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600 
         transition-colors duration-200 cursor-pointer"><LnkedIn /></li>
    <li>
    <a href="https://github.com/dorifs"
        class="bg-gray-100 text-gray-800 text-xs 
        font-medium me-2 px-2.5 py-0.5 rounded-full 
        dark:bg-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600 
         transition-colors duration-200 cursor-pointer">
         <Github />
    </li>
    </a>
   <li>
    <a href="/contact" 
     class="bg-gray-100 text-gray-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded-full 
            dark:bg-gray-700 dark:text-gray-300 flex items-center justify-center hover:bg-gray-200 dark:hover:bg-gray-600 
         transition-colors duration-200 cursor-pointer">
    <EmailIcon />
  </a>
</li>

</ul>
