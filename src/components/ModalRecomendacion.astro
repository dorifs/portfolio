---
const { id = "modal", imgSrc = "/recomencion_agilia.png", alt = "Carta de recomendación" } = Astro.props;
---

<div id={id} class="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center z-50 hidden">
  <div class="relative bg-white dark:bg-gray-800 p-4 rounded-lg shadow-xl max-w-3xl w-full">
    <button onclick={`document.getElementById('${id}').classList.add('hidden')`}
      class="absolute top-2 right-2 text-gray-500 hover:text-gray-800 dark:hover:text-white text-xl font-bold">
      ✕
    </button>
    <img src={imgSrc} alt={alt} class="rounded-md w-full max-h-[80vh] object-contain" />
  </div>
</div>
