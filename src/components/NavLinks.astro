---
export interface Props {
  nav: {
    home: string;
    projects: string;
    experience: string;
    contact: string;
  };
}

const { nav } = Astro.props;
---

<nav class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex gap-4">
  <a href="#home" class="px-4 py-2 text-sm font-semibold text-white bg-gray-800 hover:scale-110 hover:bg-blue-500 rounded shadow transition duration-300">
    {nav.home}
  </a>
  <a href="#projects" class="px-4 py-2 text-sm font-semibold text-white bg-gray-800 hover:scale-110 hover:bg-blue-500 rounded shadow transition duration-300">
    {nav.projects}
  </a>
  <a href="#experience" class="px-4 py-2 text-sm font-semibold text-white bg-gray-800 hover:scale-110 hover:bg-blue-500 rounded shadow transition duration-300">
    {nav.experience}
  </a>
  <a href="#contact" class="px-4 py-2 text-sm font-semibold text-white bg-gray-800 hover:scale-110 hover:bg-blue-500 rounded shadow transition duration-300">
    {nav.contact}
  </a>
</nav>
